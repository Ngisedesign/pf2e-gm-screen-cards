{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "api/search.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/search-5e.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/image-search.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/family.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/search-5e",
      "dest": "/api/search-5e.js"
    },
    {
      "src": "/api/search",
      "dest": "/api/search.js"
    },
    {
      "src": "/api/image-search",
      "dest": "/api/image-search.js"
    },
    {
      "src": "/api/family",
      "dest": "/api/family.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
